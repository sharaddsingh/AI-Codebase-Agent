# ─────────────────────────────────────────────────────────────────────────────
# AI Codebase Agent — environment template
#
# Copy to `.env` and fill in values. NEVER commit `.env` (it is git-ignored).
# Every secret here is read SERVER-SIDE ONLY and is never exposed to the browser.
# The one browser-visible value is NEXT_PUBLIC_API_BASE_URL (safe, just a URL).
# ─────────────────────────────────────────────────────────────────────────────

# ── Model provider ───────────────────────────────────────────────────────────
# "anthropic"  -> Anthropic Claude (Messages API at /v1/messages). The real
#                  Anthropic service; the SDK rejects base_url overrides that
#                  speak a different protocol. Requires ANTHROPIC_API_KEY.
# "openai"     -> Any OpenAI-compatible chat-completions service
#                  (api.openai.com, OpenRouter, llama.cpp with an
#                  OpenAI shim, vLLM, Ollama, ...). Requires OPENAI_API_KEY and
#                  optionally OPENAI_BASE_URL. Note: if a service sits behind
#                  Cloudflare, its Anthropic route may be blocked; the OpenAI
#                  route at the same host typically is not.
# "gemini"     -> Google Gemini native API. Requires GEMINI_API_KEY. Get a key
#                  at https://aistudio.google.com/apikey.
# "mock"       -> Deterministic scripted adapter; the whole stack runs with NO
#                  API key (useful for tests and first-run demos).
MODEL_PROVIDER=anthropic

# Secret. Required when MODEL_PROVIDER=anthropic. Read server-side only.
ANTHROPIC_API_KEY=

# Claude model name. The adapter is provider-agnostic — swapping providers is a
# single adapter class. ANTHROPIC_BASE_URL can override the API base URL if you
# route through a gateway/proxy. ANTHROPIC_MAX_TOKENS caps each response.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096

# OpenAI-compatible provider. Used only when MODEL_PROVIDER=openai. The agent
# loop already produces OpenAI-style messages and tool schemas, so any
# service that speaks /v1/chat/completions works (api.openai.com,
# OpenRouter, TaBiToken, llama.cpp + shim, vLLM, Ollama). Set OPENAI_BASE_URL
# to the host root (no trailing slash, no /v1) for non-openai.com services.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_MAX_TOKENS=4096

# Google Gemini (native protocol). Used only when MODEL_PROVIDER=gemini.
# Get a free key at https://aistudio.google.com/apikey. Free tier supports
# gemini-2.0-flash and gemini-1.5-flash; gemini-1.5-pro requires billing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=4096

# Sampling temperature for the agent (0.0 = deterministic, best for citations).
AGENT_TEMPERATURE=0.0

# ── Agent budgets (bound every investigation) ────────────────────────────────
# The agent never sends a whole codebase to the model; these caps enforce that.
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_SECONDS=150
AGENT_MAX_FILES=20
AGENT_MAX_CONTEXT_BYTES=300000
AGENT_MAX_STEPS=24

# ── Upload pipeline (browser-supplied folders) ───────────────────────────────
# Where the upload pipeline writes files. The directory is created on first
# upload and contains one subdirectory per uploaded repo. Cleaning up an
# uploaded repo also wipes its subdirectory here. In production (Render / Fly.io
# / Docker) this MUST point at a persistent volume.
UPLOAD_ROOT=./uploaded_repos

# ── GitHub access via the official GitHub MCP server (read-only) ─────────────
# GitHub repositories are investigated through the official GitHub MCP server
# over remote Streamable HTTP, authenticated by a server-side PAT.
# A token is REQUIRED for GitHub repos (the remote server mandates one even for
# public repositories). It is read only here and is never sent to the browser,
# a response, a citation, a log, or an error message.
GITHUB_TOKEN=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/readonly
GITHUB_MCP_TIMEOUT=30

# ── Server ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS. Include the production frontend URL
# (e.g. https://ai-codebase-agent.onrender.com) and any preview/staging origins.
CORS_ORIGINS=http://localhost:3000

# Where the static frontend lives inside the runtime container. Leave default.
STATIC_DIR=./static

# ── Frontend (browser-visible; safe) ─────────────────────────────────────────
# Where the browser reaches the backend. Not a secret.
# In production where the backend serves the static frontend, leave this empty
# so the browser uses same-origin "/api". For local dev pointing at a separate
# uvicorn, set it to "http://localhost:8000".
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── MCP server (standalone) ──────────────────────────────────────────────────
# Only used when you run `python mcp/server.py` directly for an external MCP
# client (e.g. Claude Desktop). OS-path-separator list. Empty = unrestricted
# (intended for single-user local use only).
MCP_ALLOWED_ROOTS=