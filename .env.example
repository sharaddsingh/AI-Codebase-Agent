# ─────────────────────────────────────────────────────────────────────────────
# AI Codebase Engineering Agent — environment template
#
# Copy to `.env` and fill in values. NEVER commit `.env` (it is git-ignored).
# Every secret here is read SERVER-SIDE ONLY and is never exposed to the browser.
# The one browser-visible value is NEXT_PUBLIC_API_BASE_URL (safe: just a URL).
# ─────────────────────────────────────────────────────────────────────────────

# ── Model provider ───────────────────────────────────────────────────────────
# "anthropic" = call a real Claude model (requires ANTHROPIC_API_KEY).
# "mock"      = deterministic scripted adapter; run the whole app with NO API key.
MODEL_PROVIDER=anthropic

# Secret. Required only when MODEL_PROVIDER=anthropic. Read server-side only.
ANTHROPIC_API_KEY=

# Claude model name. The adapter is provider-agnostic — swapping providers is a
# single adapter class. ANTHROPIC_BASE_URL can override the API base URL if you
# route through a gateway/proxy. ANTHROPIC_MAX_TOKENS caps each response.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=
ANTHROPIC_MAX_TOKENS=4096

# Sampling temperature for the agent (0.0 = deterministic, best for citations).
AGENT_TEMPERATURE=0.0

# ── Agent budgets (bound every investigation) ────────────────────────────────
# The agent never sends a whole codebase to the model; these caps enforce that.
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_SECONDS=90
AGENT_MAX_FILES=20
AGENT_MAX_CONTEXT_BYTES=200000
AGENT_MAX_STEPS=16

# ── Repository access control ────────────────────────────────────────────────
# Allow-list of roots that may be registered, separated by the OS path separator
# (";" on Windows, ":" on macOS/Linux). EMPTY = unrestricted (local-dev only; the
# backend logs a warning at startup). Set this in any shared/production deploy.
#   Windows example: ALLOWED_REPO_ROOTS=C:\code;D:\work
#   POSIX example:   ALLOWED_REPO_ROOTS=/home/me/code:/srv/repos
ALLOWED_REPO_ROOTS=

# Honor a repository's root .gitignore when listing/searching (built-in deny-list
# for .git/node_modules/build output always applies regardless of this flag).
RESPECT_GITIGNORE=true

# Optional: auto-register one repo at startup (handy for demos). Absolute path.
# e.g. DEFAULT_REPO_PATH=C:\Users\me\OneDrive\Desktop\ai-codebase-agent\tests\fixtures\sample_repo
DEFAULT_REPO_PATH=

# ── GitHub access (read-only, server-side only) ──────────────────────────────
# Register a GitHub repo by URL (https://github.com/owner/repo) and it is read
# over the GitHub REST API — no clone, pinned to a commit. Both fields are
# OPTIONAL: public repos work with no token, but GitHub then rate-limits by IP
# (~60 requests/hour), so a large repo's search may report partial coverage.
# A Personal Access Token raises the limit and enables private repos. The token
# is a SECRET, read server-side only; it is never sent to the browser, returned
# in a response/citation, written to a log, or included in an error message.
GITHUB_TOKEN=
# Override only for GitHub Enterprise or a proxy; leave as-is for github.com.
GITHUB_API_BASE_URL=https://api.github.com

# ── Server ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (the frontend dev server).
CORS_ORIGINS=http://localhost:3000

# ── Frontend (browser-visible; safe) ─────────────────────────────────────────
# Where the browser reaches the backend. Not a secret.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── MCP server (standalone) ──────────────────────────────────────────────────
# Only used when you run `python mcp/server.py` directly for an external MCP
# client. Same semantics as ALLOWED_REPO_ROOTS. EMPTY = unrestricted.
MCP_ALLOWED_ROOTS=
