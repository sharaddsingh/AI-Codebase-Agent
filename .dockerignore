# Keep the backend build context (repo root) small and secret-free.
.git
.venv
venv
env
**/__pycache__
*.py[cod]
*.egg-info
.eggs
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Never ship env files or logs into an image
.env
.env.*
!.env.example
*.log
logs
data
tmp
.cache

# Frontend build output & deps (frontend image builds its own)
frontend/node_modules
frontend/.next
frontend/out
node_modules

# Editor / OS
.idea
.vscode
.DS_Store
Thumbs.db
